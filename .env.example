# MyRJ environment variables. Copy to .env.local and fill in what you need.
# Never commit .env.local. Nothing here is required to boot the app, but the RJ
# needs at least a music source (Spotify or YouTube) and a voice to be useful.

# ── Claude (RJ scripts, language labelling, playlist/screenshot import) ──
# Recommended. Without it the RJ falls back to built-in template lines.
# Get one: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional model override (default is a small, cheap Claude Haiku model)
# ANTHROPIC_MODEL=

# ── Voice: Azure Speech (recommended, has a free tier) ──
# Azure Portal → create "Speech service" → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Optional custom TTS base URL
# AZURE_TTS_BASE=
# Optional alternative voice: ElevenLabs (https://elevenlabs.io → Profile → API key)
# ELEVENLABS_API_KEY=
# If no voice key is set, the browser's built-in speechSynthesis is used.

# ── Spotify (optional source; needs Spotify Premium to play) ──
# https://developer.spotify.com/dashboard → Create app → Web API + Web Playback SDK
# Spotify dev-mode apps allow only 5 allow-listed users and have a shared quota.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in the Spotify dashboard exactly. Use 127.0.0.1, not localhost.
#   local: http://127.0.0.1:3000/api/auth/callback/spotify
#   prod:  https://YOUR-APP.vercel.app/api/auth/callback/spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/spotify

# ── Google / YouTube (optional source; Premium makes it ad-free) ──
# Google Cloud Console → enable "YouTube Data API v3" → OAuth consent screen (External,
# add yourself as a test user) → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to <your origin>/api/auth/callback/youtube
# GOOGLE_REDIRECT_URI=
# Optional API key (YouTube Data API) for lookups without a signed-in user
# YOUTUBE_API_KEY=

# ── Supabase (optional: accounts, sync across devices, per-user tokens) ──
# https://supabase.com → New project → Project Settings → API
# Without these the app runs logged-out and keeps settings in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Secret key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to encrypt stored refresh tokens: openssl rand -base64 32
# Set once and don't change it, or stored tokens stop working.
TOKEN_ENCRYPTION_KEY=

# ── Optional: other LLM instead of Claude (any OpenAI-compatible API) ──
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=8000
