# Spotify (app at developer.spotify.com; add the redirect URI there too)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# local: http://127.0.0.1:3000/api/auth/callback/spotify
# prod:  https://ai-rj.vercel.app/api/auth/callback/spotify
SPOTIFY_REDIRECT_URI=

# ElevenLabs (needs Text to Speech + Voices read)
ELEVENLABS_API_KEY=

# Supabase (not used by the single-user MVP yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional LLM for RJ scripts (any OpenAI-compatible API). Without it, templates are used.
OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
